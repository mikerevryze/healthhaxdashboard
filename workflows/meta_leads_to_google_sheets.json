    {
      "parameters": {
        "jsCode": "// Extract first_name, last_name, email, phone from Meta lead field_data.\n// Meta Lead Ads return field_data as an array of { name, values } objects.\nreturn items.map(item => {\n  const lead = item.json;\n  const fields = lead.field_data || [];\n\n  const getField = (name) => {\n    const field = fields.find(f =>\n      f.name.toLowerCase() === name.toLowerCase()\n    );\n    return field && field.values && field.values.length > 0\n      ? field.values[0]\n      : '';\n  };\n\n  return {\n    json: {\n      lead_id: lead.id || '',\n      created_time: lead.created_time || '',\n      first_name: getField('first_name'),\n      last_name: getField('last_name'),\n      email: getField('email'),\n      phone_number: getField('phone_number')\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1024, -96],
      "id": "ml000000-0011-4000-8000-000000000001",
      "name": "Extract Lead Fields"
    },
