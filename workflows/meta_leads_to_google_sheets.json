          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "First Name": "={{ $json.first_name }}",
            "Last Name": "={{ $json.last_name }}",
            "Email": "={{ $json.email }}",
            "Phone Number": "={{ $json.phone_number }}",
            "Lead ID": "={{ $json.lead_id }}",
