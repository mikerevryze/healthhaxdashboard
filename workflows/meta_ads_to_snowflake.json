    {
      "parameters": {
        "jsCode": "// Build date range: from (days_back ago) to yesterday\nconst daysBack = $input.first().json.days_back || 30;\nconst now = new Date();\n\nconst since = new Date(now);\nsince.setDate(since.getDate() - daysBack);\n\nconst until = new Date(now);\nuntil.setDate(until.getDate() - 1);\n\nconst fmt = (d) => d.toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    ad_account_id: $input.first().json.ad_account_id,\n    access_token: $input.first().json.access_token,\n    since: fmt(since),\n    until: fmt(until)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [64, -96],
      "id": "m1a00000-0003-4000-8000-000000000001",
