    {
      "parameters": {
        "jsCode": "// Build a single batch MERGE SQL from ALL rows in the API response\n// This ensures all data is inserted in ONE Snowflake call\nconst response = $input.first().json;\nconst rows = response.data || [];\nconst pulledAt = new Date().toISOString();\n\nfunction getAction(actions, type) {\n  const a = (actions || []).find(x => x.action_type === type);\n  return a ? Number(a.value) : 0;\n}\n\nfunction esc(s) {\n  return String(s || '').replace(/'/g, \"''\");\n}\n\nconst selects = rows.map(r => {\n  const leads =\n    getAction(r.actions, 'lead') +\n    getAction(r.actions, 'onsite_conversion.lead_grouped') +\n    getAction(r.actions, 'offsite_conversion.fb_pixel_lead');\n\n  return `SELECT\n    TRY_TO_TIMESTAMP_NTZ('${pulledAt}') AS PULLED_AT,\n    TO_DATE('${r.date_start}') AS DATE_START,\n    TO_DATE('${r.date_stop}') AS DATE_STOP,\n    '${esc(r.account_id)}' AS AD_ACCOUNT_ID,\n    '${esc(r.account_currency)}' AS CURRENCY,\n    'ad' AS LEVEL,\n    '${esc(r.campaign_id)}' AS CAMPAIGN_ID,\n    '${esc(r.campaign_name)}' AS CAMPAIGN_NAME,\n    '${esc(r.adset_id)}' AS ADSET_ID,\n    '${esc(r.adset_name)}' AS ADSET_NAME,\n    '${esc(r.ad_id)}' AS AD_ID,\n    '${esc(r.ad_name)}' AS AD_NAME,\n    ${Number(r.impressions || 0)} AS IMPRESSIONS,\n    ${Number(r.clicks || 0)} AS CLICKS,\n    ${Number(r.spend || 0)} AS SPEND,\n    ${leads} AS LEADS,\n    0 AS PURCHASES`;\n}).join('\\n  UNION ALL\\n');\n\nconst sql = `MERGE INTO REVRYZE.RAW.META_ADS_DAILY t\nUSING (\n  ${selects}\n) s\nON  t.DATE_START     = s.DATE_START\nAND t.AD_ACCOUNT_ID  = s.AD_ACCOUNT_ID\nAND t.AD_ID          = s.AD_ID\n\nWHEN MATCHED THEN UPDATE SET\n  PULLED_AT     = s.PULLED_AT,\n  DATE_STOP     = s.DATE_STOP,\n  CURRENCY      = s.CURRENCY,\n  LEVEL         = s.LEVEL,\n  CAMPAIGN_ID   = s.CAMPAIGN_ID,\n  CAMPAIGN_NAME = s.CAMPAIGN_NAME,\n  ADSET_ID      = s.ADSET_ID,\n  ADSET_NAME    = s.ADSET_NAME,\n  AD_NAME       = s.AD_NAME,\n  IMPRESSIONS   = s.IMPRESSIONS,\n  CLICKS        = s.CLICKS,\n  SPEND         = s.SPEND,\n  LEADS         = s.LEADS,\n  PURCHASES     = s.PURCHASES\n\nWHEN NOT MATCHED THEN INSERT (\n  PULLED_AT, DATE_START, DATE_STOP, AD_ACCOUNT_ID, CURRENCY, LEVEL,\n  CAMPAIGN_ID, CAMPAIGN_NAME, ADSET_ID, ADSET_NAME, AD_ID, AD_NAME,\n  IMPRESSIONS, CLICKS, SPEND, LEADS, PURCHASES\n)\nVALUES (\n  s.PULLED_AT, s.DATE_START, s.DATE_STOP, s.AD_ACCOUNT_ID, s.CURRENCY, s.LEVEL,\n  s.CAMPAIGN_ID, s.CAMPAIGN_NAME, s.ADSET_ID, s.ADSET_NAME, s.AD_ID, s.AD_NAME,\n  s.IMPRESSIONS, s.CLICKS, s.SPEND, s.LEADS, s.PURCHASES\n);`;\n\n// Also pass along paging info for pagination\nconst nextUrl = response?.paging?.next || '';\n\nreturn [{ json: { sql, row_count: rows.length, next_url: nextUrl } }];\n"
      },
