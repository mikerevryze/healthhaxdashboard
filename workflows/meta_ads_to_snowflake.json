    {
      "parameters": {
        "jsCode": "// Transform Meta Insights rows into Snowflake-friendly format.\n// Extract 'lead' count from the actions array.\nconst config = $('Config').first().json;\n\nreturn items.map(item => {\n  const row = item.json;\n\n  // actions is an array like [{action_type:'lead', value:'3'}, ...]\n  const actions = row.actions || [];\n  const leadAction = actions.find(a =>\n    a.action_type === 'lead' ||\n    a.action_type === 'onsite_conversion.lead_grouped' ||\n    a.action_type === 'offsite_conversion.fb_pixel_lead'\n  );\n  const leads = leadAction ? Number(leadAction.value) : 0;\n\n  return {\n    json: {\n      date_key: row.date_start,\n      ad_account_id: config.ad_account_id,\n      campaign_id: row.campaign_id || 'unknown',\n      campaign_name: (row.campaign_name || 'Unknown').replace(/'/g, \"''\"),\n      spend: Number(row.spend) || 0,\n      impressions: Number(row.impressions) || 0,\n      clicks: Number(row.clicks) || 0,\n      leads: leads,\n      raw: JSON.stringify(row).replace(/'/g, \"''\"),\n      pulled_at_ts: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [704, -96],
      "id": "m1a00000-0008-4000-8000-000000000001",
      "name": "Transform for Snowflake"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "MERGE INTO REVRYZE.RAW.META_ADS_DAILY t\nUSING (\n  SELECT\n    TO_DATE('{{$json.date_key}}') AS DATE_KEY,\n    '{{$json.ad_account_id}}' AS AD_ACCOUNT_ID,\n    '{{$json.campaign_id}}' AS CAMPAIGN_ID,\n    '{{$json.campaign_name}}' AS CAMPAIGN_NAME,\n    TRY_TO_NUMBER('{{$json.spend}}', 18, 2) AS SPEND,\n    TRY_TO_NUMBER('{{$json.impressions}}', 18, 0) AS IMPRESSIONS,\n    TRY_TO_NUMBER('{{$json.clicks}}', 18, 0) AS CLICKS,\n    TRY_TO_NUMBER('{{$json.leads}}', 18, 0) AS LEADS,\n    TRY_PARSE_JSON('{{$json.raw}}') AS RAW,\n    TRY_TO_TIMESTAMP_NTZ('{{$json.pulled_at_ts}}') AS PULLED_AT_TS\n) s\n\nON t.DATE_KEY = s.DATE_KEY\n  AND t.AD_ACCOUNT_ID = s.AD_ACCOUNT_ID\n  AND t.CAMPAIGN_ID = s.CAMPAIGN_ID\n\nWHEN MATCHED THEN UPDATE SET\n  CAMPAIGN_NAME = s.CAMPAIGN_NAME,\n  SPEND = s.SPEND,\n  IMPRESSIONS = s.IMPRESSIONS,\n  CLICKS = s.CLICKS,\n  LEADS = s.LEADS,\n  RAW = s.RAW,\n  PULLED_AT_TS = s.PULLED_AT_TS\n\nWHEN NOT MATCHED THEN INSERT (\n  DATE_KEY, AD_ACCOUNT_ID, CAMPAIGN_ID, CAMPAIGN_NAME,\n  SPEND, IMPRESSIONS, CLICKS, LEADS,\n  RAW, PULLED_AT_TS\n)\nVALUES (\n  s.DATE_KEY, s.AD_ACCOUNT_ID, s.CAMPAIGN_ID, s.CAMPAIGN_NAME,\n  s.SPEND, s.IMPRESSIONS, s.CLICKS, s.LEADS,\n  s.RAW, s.PULLED_AT_TS\n);\n"
      },
      "type": "n8n-nodes-base.snowflake",
      "typeVersion": 1,
      "position": [864, -96],
      "id": "m1a00000-0009-4000-8000-000000000001",
      "name": "Snowflake",
      "credentials": {
        "snowflake": {
          "id": "lSGl0Euzea9Zvmt7",
          "name": "Snowflake account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Check if there's a next page of results (Meta paginates at 500+)\nconst response = $('Fetch Meta Insights').first().json;\nconst nextUrl = response?.paging?.next;\n\nif (nextUrl) {\n  return [{ json: { next_url: nextUrl } }];\n}\n\n// No more pages — stop\nreturn [];"
      },
